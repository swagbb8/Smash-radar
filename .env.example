# SMASH RADAR — copy to .env and adjust. Everything is optional.
PORT=8787
HOST=0.0.0.0
DATABASE_PATH=./data/smash-radar.json

# Automatic sweeps (minutes). fast = DuPage, NWS, breaking; normal = most feeds; slow = niche feeds.
AUTO_REFRESH=on
FAST_INTERVAL_MINUTES=5
NORMAL_INTERVAL_MINUTES=20
SLOW_INTERVAL_MINUTES=60
# Daily forced full sweep (America/Chicago)
DAILY_REFRESH_HOUR=5
DAILY_REFRESH_MINUTE=15

FETCH_CONCURRENCY=8
FETCH_TIMEOUT_MS=12000
RETENTION_DAYS=14
# Article-page enrichment (real og:image + fuller summaries). Set ENRICH=off to disable.
ENRICH=on
ENRICH_LIMIT=40

# Optional: AI-polished summaries + "why it matters" (Claude). Leave blank to use the built-in rules.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
AI_LIMIT=15

# Optional: replace the built-in source registry with your own JSON list.
# SOURCES_FILE=./my-sources.json
